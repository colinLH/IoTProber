  <head>
    <meta charset=""UTF-8"">
    <title>FortiGate</title>
    <base href=""/"">
    <meta name=""viewport"" content=""width=device-width, initial-scale=1"">
    <link rel=""shortcut icon"" type=""image/x-icon"" href=""favicon/favicon.ico"">
