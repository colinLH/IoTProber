			var mmcPortSuffix = 13;
			var protocolFromRequest = window.location.protocol;
			if(protocolFromRequest.indexOf(""https"") >= 0){
				mmcPortSuffix = 14;
			}
			return 50000 + 100*instanceId + mmcPortSuffix; 
		}
    </script>
