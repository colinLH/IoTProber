  <script>
    var fetchACAPStatus = function () {
      var ajaxRequest = AxisConnectionFactory.createAjaxConnection();
      var url = ""/operator/axis-cgi/applications/list.cgi"";

      AxisConnectionFactory.sendSync([""GET"", url], null, ajaxRequest);

      return ajaxRequest.getStatus() == 200
        ? ajaxRequest.getResponseXml()
        : null;
    };

    var redirectToAcap = function () {
      var acapStatus;
      var acapVersion;
      var response = fetchACAPStatus();

      if (response) {
        //Check which browser user is using
        var ua = window.navigator.userAgent;
        var ie = ua.indexOf('MSIE ') !== -1 || !!ua.match(/Trident.*rv\\:11\\./);

        var acapStatusObj = ie
          ? response.childNodes[0].childNodes[0]
          : response.querySelector('application[NiceName=""AXIS Audio Player""]');

        if (acapStatusObj) {
          acapStatus = acapStatusObj.getAttribute('Status');
          acapVersion = acapStatusObj.getAttribute('Version');
        }
      }

      // Version 0.9-0 and 0.10-0 can not return to product pages.
      var acapIsOld = (acapVersion === ""0.9-0"") || (acapVersion === ""0.10-0"");

      var acapIsRunning = acapStatus === ""Running"";
      var returningFromAcap = window.location.search === ""?from=acap"";

      return !returningFromAcap && acapIsRunning && !acapIsOld;
    };
  </script>

