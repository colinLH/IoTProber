  <script>
    var connTimes = 0;
    var initConnection = function(){
      if (navigator.userAgent.indexOf('MSIE') !== -1 || navigator.appVersion.indexOf('Trident/') > 0) {
        // MSIE
        var obj = document.getElementById(""logincontroller"");
        try{
          obj.Connect(
            function(){
              console.log(""success and redirect to home.html"");
              window.location = ""/home.html"";
            },
            function(err, errtxt, body){
              console.log(""fail"", err, errtxt, body);
              connTimes ++;
              if (connTimes >= 3) {
                  document.write(body);
              }
              else {
                  setTimeout(initConnection, 50);
              }
            }
          );
        }
        catch(ex){
          document.getElementById(""plugin-non-installed"").style.display = ""flex"";
        }
      }
      else {
        window.location = ""/home.html"";
      }
    }
  </script>
  <style>
    body,html {
        margin: 0;
        padding: 0;
    }
    .flex {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-around;
      height: 60vh;
      margin-top: 30px;
    }
    .plugin-contain {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .text {
      font-size: 32px;
      font-family: Roboto, Arial, Verdana;
      font-weight: bold;
      margin-top: 30px;
    }
    .button {
      background-color: white; 
      color: #2991D7;
      font-weight: bold;
      border: 2px solid #008CBA;
      height: 40px;
      width: 180px;
      margin-top: 30px;
      cursor: pointer;
    }
  </style>
</head>
